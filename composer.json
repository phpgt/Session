{
	"name": "phpgt/session",
	"description": "Encapsulated user sessions.",
	"license": "MIT",

	"require": {
		"php": ">=8.2",
		"phpgt/typesafegetter": "^1.3"
	},
	"suggest": {
		"ext-redis": "Required to use Gt\\Session\\RedisHandler."
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.1",
		"phpmd/phpmd": "^2.13",
		"squizlabs/php_codesniffer": "^3.7"
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpunit:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration phpunit.xml --coverage-text",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"test": [
			"@phpunit",
			"@phpstan",
			"@phpcs",
			"@phpmd"
		]
	},

	"autoload": {
		"psr-4": {
			"Gt\\Session\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Gt\\Session\\Test\\": "./test/phpunit"
		}
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/PhpGt"
		}
	]
}
